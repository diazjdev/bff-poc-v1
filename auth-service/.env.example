# Auth0 tenant domain WITHOUT the scheme.
# index.js builds the issuer as `https://${AUTH0_DOMAIN}` — do not include https:// here.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_CALLBACK_URL=http://localhost:3001/auth/callback
SESSION_SECRET=generate-with-node-crypto-randomBytes-32-hex
PORT=3001
CLIENT_ORIGIN=http://localhost:4200
